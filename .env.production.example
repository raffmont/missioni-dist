# Public, non-secret production settings. Copy to .env.production outside Git.
COMPOSE_PROJECT_NAME=missioni-dist-production
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_IMAGE=missioni-dist:CHANGE_ME_RELEASE
PUBLIC_FQDN=CHANGE_ME.uniparthenope.it
ALLOWED_HOSTS=CHANGE_ME.uniparthenope.it
ALLOWED_ORIGINS=https://CHANGE_ME.uniparthenope.it
FORWARDED_ALLOW_IPS=CHANGE_ME_PROXY_IP_OR_CIDR
RETENTION_DAYS=365
MAX_UPLOAD_BYTES=15000000
MAX_PDF_PAGES=30

# Absolute root-owned files, mode 0600, outside the repository.
DATABASE_URL_SECRET_FILE=/etc/missioni-dist/secrets/database_url
POSTGRES_PASSWORD_SECRET_FILE=/etc/missioni-dist/secrets/postgres_password
MINIO_ACCESS_KEY_SECRET_FILE=/etc/missioni-dist/secrets/minio_access_key
MINIO_SECRET_KEY_SECRET_FILE=/etc/missioni-dist/secrets/minio_secret_key
BACKUP_AGE_RECIPIENTS_FILE=/etc/missioni-dist/secrets/backup_age_recipients
